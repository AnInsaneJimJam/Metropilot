# Hosted secrets. Copy to .env.hosting (git-ignored) and fill in; never commit real values.
# infra/scripts/put-secrets.sh reads this file and writes each service's Secrets Manager secret.
# Multi-line values: use KEY_FILE=path instead of KEY=value. Text after " #" is a comment; delete it with the value.

# Privy app (hosted sign-in, custody wallets, live signing)
PRIVY_APP_ID= # Privy dashboard app ID
PRIVY_VERIFICATION_KEY_FILE=./.secrets/privy-verification.pem
PRIVY_APP_SECRET= # Privy dashboard app secret
PRIVY_AUTHORIZATION_KEY= # wallet-auth:... from: node scripts/custody-proof.ts --new-key

# Monad mainnet RPC (funds scanner, executor). The executor falls back to CUSTODY_RPC when LIVE_RPC is empty.
CUSTODY_RPC=https://rpc.monad.xyz
CUSTODY_RPC_SECONDARY= # optional second endpoint for cross-checked finality
LIVE_RPC= # optional

# Envio HyperSync deposit index (optional)
ENVIO_API_TOKEN= # optional

# Kimi through Vercel AI Gateway (control/broker process only)
AI_GATEWAY_API_KEY= # optional; enables real Kimi decisions with the verification file
KIMI_VERIFICATION_JSON_FILE= # optional path to the Kimi verification JSON

# Generated on the first run when empty and kept here afterwards: POSTGRES_PASSWORD, EXECUTOR_CAPABILITY_SECRET,
# BROKER_CAPABILITY_SECRET, RUNTIME_WORKLOAD_SECRET. DATABASE_URL and EXECUTOR_DATABASE_URL are composed.
