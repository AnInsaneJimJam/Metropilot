{
  "name": "monad-hack",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "scripts": {
    "bootstrap": "pnpm install --frozen-lockfile && pnpm db:preflight && pnpm db:up && pnpm db:migrate && pnpm db:seed && REQUIRE_DB=1 pnpm check",
    "check": "pnpm generate && tsc -p tsconfig.json && pnpm --filter @monad-hack/web typecheck && node --env-file-if-exists=.env --test",
    "db:preflight": "node --env-file-if-exists=.env apps/api/src/db/cli.ts preflight",
    "db:up": "docker compose --project-directory . -f infra/compose.yaml up -d --wait",
    "db:migrate": "node --env-file-if-exists=.env apps/api/src/db/cli.ts migrate",
    "db:seed": "node --env-file-if-exists=.env apps/api/src/db/cli.ts seed",
    "db:seed:live": "node --env-file-if-exists=.env apps/api/src/db/cli.ts seed-live",
    "db:down": "docker compose --project-directory . -f infra/compose.yaml down",
    "db:reset": "docker compose --project-directory . -f infra/compose.yaml down --volumes",
    "generate": "node packages/contracts/src/generate.mjs",
    "web:dev": "pnpm --filter @monad-hack/web dev",
    "strategy:demo": "pnpm generate && node packages/strategy/src/demo.ts",
    "api:dev": "pnpm generate && node --env-file-if-exists=.env apps/api/src/server.ts",
    "runtime:demo": "pnpm generate && node apps/runtime/src/demo.ts",
    "api:runtime": "pnpm generate && LOCAL_RUNTIME_CONTROL=1 node --env-file-if-exists=.env apps/api/src/runtime-control/server.ts",
    "executor:dev": "pnpm generate && LOCAL_EXECUTOR=1 node --env-file-if-exists=.env apps/executor/src/main.ts",
    "stack:dev": "pnpm generate && node scripts/stack-dev.mjs",
    "custody:proof": "node --env-file-if-exists=.env scripts/custody-proof.ts",
    "custody:hypersync": "node --env-file-if-exists=.env scripts/hypersync-check.ts"
  },
  "devDependencies": {
    "@types/node": "24.19.0",
    "@types/pg": "8.23.1",
    "json-schema-to-typescript": "16.0.0",
    "pg": "8.23.1",
    "typescript": "7.0.2"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.21.0",
      "onFail": "download"
    }
  }
}
