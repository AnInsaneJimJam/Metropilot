{
  "description": "atomic amount of 2^256 overflows uint256",
  "expect": {
    "fieldPath": "/triggers/0/body/0/amount/atomic",
    "keyword": "format"
  },
  "document": {
    "schemaVersion": "strategy/1",
    "id": "threshold_sale",
    "name": "Paper threshold partial sale",
    "triggers": [
      {
        "id": "crossing",
        "type": "price.crossesAbove",
