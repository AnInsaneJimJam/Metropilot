            "connectorRef": "paper.uniswap",
            "tokenInRef": "paper.WETH",
            "tokenOutRef": "paper.USD",
            "amount": {
              "kind": "fixed",
              "atomic": "115792089237316195423570985008687907853269984665640564039457584007913129639936"
            },
            "maxSlippageBps": 50
          },
          {
            "id": "record_result",
            "type": "notify",
            "message": "Threshold sale settled in paper mode.",
            "inputs": {}
          }
        ]
      }
    ],
    "limits": {
      "maxStepsPerRun": 100,
      "maxAiCallsPerRun": 1,
      "maxIntentsPerRun": 1,
      "maxActiveSecondsPerRun": 60
    }
