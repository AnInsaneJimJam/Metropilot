{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://monad-hack.example/schemas/assignment-poll-1.schema.json",
  "title": "AssignmentPoll",
  "description": "Long-poll request from a warm runtime for its next assignment, assignment-poll/1 (decision D33). The runtime has no inbound port, so it asks; identity comes from workload authentication, not this body.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runtimeId",
    "state",
    "waitSeconds"
  ],
  "properties": {
    "schemaVersion": {
      "const": "assignment-poll/1"
    },
    "runtimeId": {
      "$ref": "common.schema.json#/$defs/opaqueKey"
    },
    "state": {
      "type": "string",
      "enum": [
        "ready",
        "idle"
      ]
    },
    "lastAssignmentId": {
      "$ref": "common.schema.json#/$defs/uuidv7"
    },
    "waitSeconds": {
      "type": "integer",
      "minimum": 0,
      "maximum": 30
    }
  }
}
