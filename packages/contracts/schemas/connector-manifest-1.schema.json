{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://monad-hack.example/schemas/connector-manifest-1.schema.json",
  "title": "ConnectorManifest",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "connector-manifest/1"
    },
    "ref": {
      "$ref": "common.schema.json#/$defs/catalogRef"
    },
    "version": {
      "type": "string",
      "maxLength": 32,
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "networkRef": {
      "const": "paper-monad"
    },
    "mode": {
      "const": "paper"
    },
    "sourceNetworkRef": {
      "const": "monad-mainnet"
    },
    "sourceChainId": {
      "const": 143
    },
    "protocol": {
      "enum": [
        "uniswap-v3",
        "curve-stableswap-ng",
        "aave-v3"
      ]
    },
    "poolAddress": {
      "type": "string",
      "pattern": "^0x[0-9a-f]{40}$"
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "$ref": "common.schema.json#/$defs/capabilityId"
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      }
    },
    "verifiedAt": {
      "$ref": "common.schema.json#/$defs/timestamp"
    }
  },
  "required": [
    "schemaVersion",
    "ref",
    "version",
    "networkRef",
    "mode",
    "sourceNetworkRef",
    "sourceChainId",
    "protocol",
    "poolAddress",
    "capabilities",
    "limitations",
    "verifiedAt"
  ]
}
