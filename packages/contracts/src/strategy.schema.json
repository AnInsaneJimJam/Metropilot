            "modelProfileRef": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120,
              "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,119}$"
            },
            "prompt": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000
            },
            "inputs": {
              "type": "object",
              "propertyNames": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
              },
              "maxProperties": 16,
              "additionalProperties": {
                "$ref": "#/$defs/Expression"
              },
              "minProperties": 1
            },
            "outputSchemaRef": {
              "type": "string",
              "enum": [
                "decision/1",
                "summary/1"
              ]
            },
            "timeoutSeconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 60
            },
            "maxOutputTokens": {
              "type": "integer",
              "minimum": 1,
              "maximum": 8192
            },
            "bind": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
            }
          },
