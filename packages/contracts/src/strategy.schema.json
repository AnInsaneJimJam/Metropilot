            "connectorRef": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120,
              "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,119}$"
            },
            "operation": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120,
              "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,119}$"
            },
            "arguments": {
              "type": "object",
              "propertyNames": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
              },
              "maxProperties": 16,
              "additionalProperties": {
                "$ref": "#/$defs/Expression"
              }
            },
            "bind": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
            }
          },
          "required": [
            "id",
            "type",
            "connectorRef",
            "operation",
            "arguments",
            "bind"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
            },
            "type": {
