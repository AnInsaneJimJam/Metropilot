              "maxLength": 64,
              "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
            },
            "type": {
              "const": "if"
            },
            "condition": {
              "$ref": "#/$defs/Expression"
            },
            "then": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Statement"
              },
              "minItems": 0,
              "maxItems": 100
            },
            "else": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Statement"
              },
              "minItems": 0,
              "maxItems": 100
            }
          },
          "required": [
            "id",
            "type",
            "condition",
            "then",
            "else"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
            },
            "type": {
              "const": "repeat"
            },
            "count": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10
            },
            "body": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Statement"
              },
              "minItems": 0,
              "maxItems": 100
            }
          },
          "required": [
            "id",
            "type",
            "count",
            "body"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
            },
            "type": {
              "const": "swap.exactInput"
            },
            "connectorRef": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120,
              "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,119}$"
            },
            "tokenInRef": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120,
              "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,119}$"
            },
            "tokenOutRef": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120,
              "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,119}$"
            },
            "amount": {
              "$ref": "#/$defs/Amount"
            },
            "maxSlippageBps": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000
            }
          },
          "required": [
