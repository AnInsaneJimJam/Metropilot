              }
            }
          },
          "required": [
            "id",
            "type",
            "message",
            "inputs"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
