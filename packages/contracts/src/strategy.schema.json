{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://monad-hack.local/strategy/1",
  "title": "Strategy",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "strategy/1"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "triggers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Trigger"
      },
      "minItems": 1,
      "maxItems": 3
    },
    "limits": {
      "type": "object",
      "properties": {
        "maxStepsPerRun": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "maxAiCallsPerRun": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "maxIntentsPerRun": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "maxActiveSecondsPerRun": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60
        }
      },
      "required": [
        "maxStepsPerRun",
        "maxAiCallsPerRun",
        "maxIntentsPerRun",
        "maxActiveSecondsPerRun"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "name",
    "triggers",
    "limits"
  ],
  "additionalProperties": false,
  "$defs": {
    "Price": {
      "type": "object",
      "properties": {
        "baseAssetRef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,119}$"
        },
        "quoteUnit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,119}$"
        },
        "decimal": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{0,17}[1-9])?$"
        }
      },
      "required": [
        "baseAssetRef",
        "quoteUnit",
        "decimal"
      ],
      "additionalProperties": false
    },
    "Money": {
      "type": "object",
      "properties": {
        "assetRef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,119}$"
        },
        "atomic": {
          "type": "string",
          "minLength": 1,
          "maxLength": 78,
          "pattern": "^(0|[1-9][0-9]*)$",
          "format": "uint256"
        }
      },
      "required": [
        "assetRef",
        "atomic"
      ],
      "additionalProperties": false
    },
    "Amount": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "fixed"
            },
            "atomic": {
              "type": "string",
              "minLength": 1,
              "maxLength": 78,
              "pattern": "^[1-9][0-9]*$",
              "format": "uint256"
            }
          },
          "required": [
            "kind",
            "atomic"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "positionBps"
            },
            "bps": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000
            }
          },
          "required": [
            "kind",
            "bps"
          ],
          "additionalProperties": false
        }
      ]
    },
    "Expression": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "literal"
            },
            "valueType": {
              "const": "Boolean"
            },
            "value": {
              "type": "boolean"
            }
          },
          "required": [
            "kind",
            "valueType",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "literal"
            },
            "valueType": {
              "const": "Integer"
            },
            "value": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "kind",
            "valueType",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "literal"
            },
            "valueType": {
              "const": "Decimal"
            },
            "value": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100,
              "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]{0,17}[1-9])?$"
            }
          },
          "required": [
            "kind",
            "valueType",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "literal"
            },
            "valueType": {
              "const": "Money"
            },
            "value": {
              "$ref": "#/$defs/Money"
            }
          },
          "required": [
            "kind",
            "valueType",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "literal"
            },
            "valueType": {
              "const": "Price"
            },
            "value": {
              "$ref": "#/$defs/Price"
            }
          },
          "required": [
            "kind",
            "valueType",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "literal"
            },
            "valueType": {
              "const": "Timestamp"
            },
            "value": {
              "type": "string",
              "minLength": 24,
              "maxLength": 24,
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
            }
          },
          "required": [
            "kind",
            "valueType",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "literal"
            },
            "valueType": {
              "const": "Enum"
            },
            "value": {
              "type": "string",
              "enum": [
                "allow",
                "skip"
              ]
            }
          },
          "required": [
            "kind",
            "valueType",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "ref"
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
            }
          },
          "required": [
            "kind",
            "name"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "field"
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
            },
            "field": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
            }
          },
          "required": [
            "kind",
            "name",
            "field"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "compare"
            },
            "operator": {
              "type": "string",
              "enum": [
                "eq",
                "ne",
                "lt",
                "lte",
                "gt",
                "gte"
              ]
            },
            "left": {
              "$ref": "#/$defs/Expression"
            },
            "right": {
              "$ref": "#/$defs/Expression"
            }
          },
          "required": [
            "kind",
            "operator",
            "left",
            "right"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "logical"
            },
            "operator": {
              "type": "string",
              "enum": [
                "and",
                "or",
                "not"
              ]
            },
            "operands": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Expression"
              },
              "minItems": 1,
              "maxItems": 8
            }
          },
          "required": [
            "kind",
            "operator",
            "operands"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "arithmetic"
            },
            "operator": {
              "type": "string",
              "enum": [
                "add",
                "subtract",
                "multiply",
                "divide"
              ]
            },
            "left": {
              "$ref": "#/$defs/Expression"
            },
            "right": {
              "$ref": "#/$defs/Expression"
            }
          },
          "required": [
            "kind",
            "operator",
            "left",
            "right"
          ],
          "additionalProperties": false
        }
      ]
    },
    "Statement": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "id": {
