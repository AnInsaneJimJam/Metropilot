# Local development only. Copy to .env (git-ignored) and change the password.
# Never put provider keys, wallet keys or production credentials in this file or in Git.

POSTGRES_USER=monad
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=monad_dev
POSTGRES_PORT=5432

DATABASE_URL=postgres://monad:change-me-local-only@127.0.0.1:5432/monad_dev

# Explicit loopback-only development workspace; never enable on a hosted server.
LOCAL_WORKSPACE=1

# Local paper stack (pnpm stack:dev). Shared only by the control API and the executor; generate with
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
EXECUTOR_CAPABILITY_SECRET=
# Separate broker signing secret, control API only. stack:dev generates both when empty.
BROKER_CAPABILITY_SECRET=
# Runtime image deployments pin; local runtimes must use the same value.
RUNTIME_IMAGE_DIGEST=0x5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a

# Live funds (docs/integration/funds.md). Off unless CUSTODY_PROVIDER is set; pnpm stack:dev defaults to the
# labelled local chain (CUSTODY_PROVIDER=local). For Privy, fill these in your own .env only, never here:
# CUSTODY_PROVIDER=privy
# PRIVY_APP_ID=
# PRIVY_APP_SECRET=
# PRIVY_AUTHORIZATION_KEY=      # node scripts/custody-proof.ts --new-key
# CUSTODY_CHAIN_ID=10143
# CUSTODY_NETWORK_REF=monad-testnet
# CUSTODY_RPC=
# CUSTODY_RPC_SECONDARY=
# CUSTODY_START_HEIGHT=
# FUNDING_TOKEN_ADDRESS=
# FUNDING_TOKEN_DECIMALS=6
# FUNDING_ASSET_REF=live.USDC
# GAS_ASSET_REF=live.MON
# ENVIO_API_TOKEN=              # HyperSync deposit index (E10); without it the scanner traces every block over RPC
# HYPERSYNC_URL=                # defaults to https://<CUSTODY_CHAIN_ID>.hypersync.xyz
# LIVE_OUTFLOWS=0               # 1 enables withdrawals; only after the E03 proof passes
# EXECUTOR_LIVE=0               # 1 runs the Monad mainnet Uniswap pipeline in the executor (needs LIVE_OUTFLOWS=1)
# LIVE_RPC=                     # Monad mainnet RPC for the executor (defaults to CUSTODY_RPC)
# LIVE_DAILY_NOTIONAL_USD_MICROS=5000000
# LIVE_GAS_CEILING_WEI=50000000000000000
# Hosted control API only (pnpm api:hosted, NODE_ENV=production; leave LOCAL_WORKSPACE unset there).
# Never put real values in this file. PRIVY_VERIFICATION_KEY is the app's PEM key from the Privy dashboard.
# PUBLIC_ORIGIN=https://studio.example
# PRIVY_APP_ID=                 # same Privy app as custody above
# PRIVY_VERIFICATION_KEY=
# HOST=0.0.0.0
# PORT=3001
